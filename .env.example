# Copy to .env.local for local dev, or set as Pages build environment variables. None of these are secrets.
VITE_SWEEP_INDEX_URL=/data/sweep-index.json
VITE_SWEEP_GEOJSON_URL=/data/sweep-sides.geojson
# Set when sweep.pmtiles is hosted (R2 public URL); empty uses the GeoJSON fallback
VITE_SWEEP_PMTILES_URL=
# Optional Protomaps basemap pmtiles (self-hosted on R2)
VITE_BASEMAP_PMTILES_URL=
VITE_API_BASE=https://sf-sweep-alerts.<your-subdomain>.workers.dev
